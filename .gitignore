.DS_Store
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

