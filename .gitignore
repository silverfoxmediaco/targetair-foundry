# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Secrets — nothing here should ever be committed.
# Note: dashboard/.env.development and dashboard/.npmrc ARE committed on
# purpose. Neither holds a secret: the OAuth client is public by design (PKCE,
# no client secret) and .npmrc reads its token from ${FOUNDRY_TOKEN} in the
# environment rather than storing one.
.env
.env.*
*.env
*.env.*
!.env.example
!dashboard/.env.development
!dashboard/.env.production
*.pem
*.key
secrets/

